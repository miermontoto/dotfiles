[
  {
    "bindings": {
      "ctrl-r": "projects::OpenRecent",
      "ctrl-d": "go_to_line::Toggle",
      "ctrl-7": "editor::ToggleComments",
      "ctrl-g": "git_panel::ToggleFocus",
      "ctrl-e": "project_panel::ToggleFocus",
      "ctrl-shift-backspace": "pane::CloseAllItems",
      "ctrl-u": "editor::DeleteLine",
      "alt-i": "zed::OpenSettings",
      "alt-k": "zed::OpenKeymap",
      "ctrl-b": "workspace::ToggleRightDock",
      "ctrl-shift-up": "editor::AddSelectionAbove",
      "ctrl-shift-down": "editor::AddSelectionBelow",
      "ctrl-shift-c": null,
      "ctrl-j": "terminal_panel::ToggleFocus",
    },
  },
  {
    "context": "Terminal",
    "bindings": {
      "ctrl-r": null, // deshabilitar "projects::OpenRecent"
      "ctrl-shift-c": "terminal::Copy",
      "ctrl-j": "terminal_panel::Toggle",
      "ctrl-v": "terminal::Paste",
    },
  },
  {
    "context": "GitPanel",
    "bindings": {
      "ctrl-shift-enter": "git::Push",
    },
  },
]
