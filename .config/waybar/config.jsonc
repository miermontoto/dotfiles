// -*- mode: jsonc -*-
{
  "reload_style_on_change": true,
  "height": 30,
  "spacing": 4,
  "modules-left": [
    "custom/uptime",
    "custom/load",
    // "custom/cores",
    "memory",
    "disk",
    "temperature",
    "custom/power-battery",
    "mpris",
  ],
  "modules-center": ["hyprland/workspaces"],
  "modules-right": [
    "pulseaudio",
    // "custom/wifi",
    "custom/weather",
    "tray",
    "clock",
    "custom/notifications",
    "custom/power",
  ],
  "tray": {
    "spacing": 10,
  },
  "clock": {
    "format": "{:%a %Y-%m-%d %H:%M:%S}",
    "interval": 1,
    "tooltip-format": "<tt>{calendar}</tt>",
  },
  "cpu": {
    "format": "{usage}%",
    "format-alt": "{avg_frequency}GHz",
    "interval": 15,
    "tooltip": true,
    "tooltip-format": "{usage}% @ {avg_frequency}GHz",
  },
  "memory": {
    "format": "<b>{total}</b>G<b>{percentage}</b>%",
    "interval": 15,
  },
  "temperature": {
    "critical-threshold": 80,
    "format": "{icon}<b>{temperatureC}</b>",
    "interval": 15,
    "format-icons": ["", "", ""],
  },
  "backlight": {
    // "device": "acpi_video1",
    "format": "{percent}% {icon}",
    "format-icons": ["🌑", "🌘", "🌗", "🌖", "🌕"],
  },
  "battery": {
    "states": {
      // "good": 95,
      "warning": 30,
      "critical": 15,
    },
    "format": "<b>{capacity}</b>%",
    "format-full": "<b>{capacity}</b>%",
    "format-charging": "{capacity}% ",
    "format-plugged": "{capacity}% ",
    "format-alt": "{time} {icon}",
    "format-icons": ["", "", "", "", ""],
  },
  "power-profiles-daemon": {
    "format": "{icon}",
    "tooltip-format": "{profile}",
    "tooltip": true,
    "format-icons": {
      "default": "",
      "performance": "",
      "balanced": "",
      "power-saver": "",
    },
  },
  "network": {
    "format-wifi": "{essid} {icon} ",
    "format-ethernet": "",
    "tooltip-format": "{ifname}: {ipaddr} → {gwaddr}",
    "format-linked": "?",
    "format-disconnected": "⚠",
    "format-icons": ["󰤯", "󰤟", "󰤢", "󰤥", "󰤨"],
  },
  "pulseaudio": {
    "format": "{volume}% {icon} {format_source}",
    "format-bluetooth": "{volume}% {icon} {format_source}",
    "format-bluetooth-muted": " {icon} {format_source}",
    "format-muted": " {format_source}",
    "format-source": "{volume}% ",
    "format-source-muted": "",
    "format-icons": {
      "headphone": "",
      "hands-free": "",
      "headset": "",
      "phone": "",
      "portable": "",
      "car": "",
      "default": ["", "", ""],
    },
    "on-click": "pavucontrol",
    "on-click-middle": "wpctl set-mute @DEFAULT_AUDIO_SINK@ toggle",
    "on-click-right": "wpctl set-mute @DEFAULT_AUDIO_SOURCE@ toggle",
  },
  "custom/power": {
    "format": "⏻",
    "tooltip": false,
    "menu": "on-click",
    "menu-file": "$HOME/.config/waybar/definitions/power_menu.xml",
    "menu-actions": {
      "shutdown": "poweroff",
      "reboot": "reboot",
      "suspend": "systemctl suspend",
      "logout": "systemctl restart gdm",
    },
  },
  "custom/uptime": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/uptime.sh",
    "return-type": "json",
    "interval": 60,
    "tooltip": false,
  },
  "custom/load": {
    "format": "<b>{}</b>",
    "exec": "cat /proc/loadavg | awk '{printf \"%.2f\", $1}'",
    "interval": 5,
    "tooltip": false,
    "on-click": "alacritty -e btop",
  },
  "custom/cores": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/cores.sh",
    "return-type": "json",
    "interval": 5,
    "tooltip": false,
  },
  "disk": {
    "format": "<b>{specific_total:0.0f}</b>G<b>{percentage_used}</b>%",
    "path": "/",
    "interval": 60,
    "unit": "GiB",
  },
  "hyprland/window": {
    "format": "{initialTitle}",
    "max-length": 50,
    "rewrite": {
      "(.*) — Mozilla Firefox": "🌐 $1",
      "(.*) - Cursor(.*)": "💻 $1",
      "(.*) - Obsidian(.*)": "📓 $1",
    },
  },
  "mpris": {
    "player-icons": {
      "spotify": "",
      "default": "🎵",
    },
    "format": "{player_icon} {artist} - {title}",
    "max-length": 40,
  },
  "custom/power-battery": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/power-battery.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "$HOME/.config/waybar/scripts/set-power-profile.sh power-saver",
    "on-click-middle": "$HOME/.config/waybar/scripts/set-power-profile.sh balanced",
    "on-click-right": "$HOME/.config/waybar/scripts/set-power-profile.sh performance",
    "tooltip": true,
  },
  "custom/notifications": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/notifications.sh",
    "return-type": "json",
    "interval": 5,
    "on-click": "makoctl restore",
    "on-click-right": "makoctl dismiss -a",
    "tooltip": true,
  },
  "custom/weather": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/weather.py waybar",
    "return-type": "json",
    "restart-interval": 900,
    "tooltip": true,
  },
  "custom/wifi": {
    "format": "{}",
    "exec": "$HOME/.config/waybar/scripts/wifi.sh",
    "return-type": "json",
    "interval": 10,
    "on-click": "nm-connection-editor",
    "tooltip": true,
  },
}
