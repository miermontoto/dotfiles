font=TX-02 10
background-color=#141618
border-color=#4E5053
output="DP-1"

# formato de notificaciones con timestamp
format=<b>%s</b>\n%b
text-color=#CDD6F4
width=350
margin=10
padding=15
border-size=2
border-radius=0
icons=1
max-icon-size=48
icon-location=left
text-alignment=left
default-timeout=5000
ignore-timeout=0
max-history=50

# colores para urgencia
[urgency=low]
border-color=#50C878

[urgency=normal]
border-color=#4E5053

[urgency=high]
border-color=#FF6B6B
default-timeout=0
